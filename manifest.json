{
  "manifest_version": 3,
  "name": "报价自动填写助手",
  "version": "2.0.0",
  "description": "打开插件自动识别本网站要填的项目，用你的本地资料库自动填写，并不断学习新项目。信息只存本地，绝不联网上传。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "报价自动填写助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
